<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- .NET Framework 4.8: Windows 10 (1903+) ve 11'de hazır gelir; ek kurulum, çalışma zamanı veya paketleyici yok -->
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Netzy</AssemblyName>
    <RootNamespace>Netzy</RootNamespace>
    <ApplicationIcon>Assets\logo.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- 64-bit Windows'ta 64-bit çalışsın: System32 araçları (nbtstat vb.) yönlendirilmeden bulunur -->
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <Deterministic>true</Deterministic>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <SatelliteResourceLanguages>none</SatelliteResourceLanguages>

    <!-- Sürüm bilgisi EXE'ye gömülür (antivirüsler sürüm bilgisi olmayan EXE'lere daha şüpheli bakar).
         CI, etiketten (v2.1.0 gibi) gelen sürümü -p:Version ile geçirir. -->
    <Version>2.0.1</Version>
    <Product>Netzy</Product>
    <AssemblyTitle>Netzy - Windows Network Repair</AssemblyTitle>
    <Description>Open-source Windows network diagnosis and repair tool</Description>
    <Company>Furkan Yaşar</Company>
    <Copyright>Copyright (c) 2026 Furkan Yaşar - MIT License</Copyright>
    <NeutralLanguage>tr-TR</NeutralLanguage>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\logo.png" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Netzy.Tests" />
  </ItemGroup>

</Project>
